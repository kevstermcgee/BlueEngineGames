[Unit]
# Standalone and optional. Under be2-hub do not enable this unit: the hub starts one server per room itself, and this one
# would hold UDP 4100, which the hub listens on.
Description=Spooky Kart dedicated server (standalone; optional, the BlueEngine hub is the recommended way, see docs/HOSTING.md)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/spooky-kart
# The join key lives in the environment file, never on the command line (it would show in `ps`).
EnvironmentFile=%h/.config/spooky-kart/server.env
ExecStart=%h/.local/bin/spooky-kart-server --listen 0.0.0.0:4100 --transport production --report-dir %h/.local/share/spooky-kart
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
