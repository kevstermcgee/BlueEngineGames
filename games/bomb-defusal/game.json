{
  "schema_version": 1,
  "name": "Bomb Defusal - Timed Ordnance Crisis",
  "map": "map.json",
  "player_profile": {
    "height": 1.8,
    "crouched_height": 1.1,
    "radius": 0.23,
    "eye_height": 1.68,
    "walk_speed": 3.2,
    "sprint_speed": 5.6,
    "crouch_speed": 1.3,
    "jump_height": 0.35
  },
  "spawn_points": [
    {
      "id": "player-1",
      "feet": [
        -3.0,
        0.0,
        3.0
      ],
      "yaw": 0.0
    }
  ],
  "counters": {
    "defused_steps": 0,
    "countdown": 10
  },
  "timers": [
    {
      "id": "tick_timer",
      "duration_ticks": 30,
      "auto_start": true,
      "repeats": true
    }
  ],
  "interactables": [
    {
      "entity": "station_alpha",
      "enabled": true,
      "visible": true
    },
    {
      "entity": "station_beta",
      "enabled": false,
      "visible": true
    },
    {
      "entity": "station_gamma",
      "enabled": false,
      "visible": true
    }
  ],
  "rules": [
    {
      "id": "timer-tick",
      "on_timer": "tick_timer",
      "condition": null,
      "once": false,
      "actions": [
        {
          "action": "increment",
          "counter": "countdown",
          "amount": -1
        }
      ]
    },
    {
      "id": "detonate",
      "on_timer": "tick_timer",
      "condition": {
        "counter": "countdown",
        "at_most": 0
      },
      "once": true,
      "actions": [
        {
          "action": "fail"
        }
      ]
    },
    {
      "id": "cut-alpha",
      "on_interact": "station_alpha",
      "condition": {
        "counter": "defused_steps",
        "equals": 0
      },
      "once": true,
      "actions": [
        {
          "action": "increment",
          "counter": "defused_steps",
          "amount": 1
        },
        {
          "action": "set_enabled",
          "entity": "station_alpha",
          "enabled": false
        },
        {
          "action": "set_enabled",
          "entity": "station_beta",
          "enabled": true
        }
      ]
    },
    {
      "id": "cut-beta",
      "on_interact": "station_beta",
      "condition": {
        "counter": "defused_steps",
        "equals": 1
      },
      "once": true,
      "actions": [
        {
          "action": "increment",
          "counter": "defused_steps",
          "amount": 1
        },
        {
          "action": "set_enabled",
          "entity": "station_beta",
          "enabled": false
        },
        {
          "action": "set_enabled",
          "entity": "station_gamma",
          "enabled": true
        }
      ]
    },
    {
      "id": "cut-gamma",
      "on_interact": "station_gamma",
      "condition": {
        "counter": "defused_steps",
        "equals": 2
      },
      "once": true,
      "actions": [
        {
          "action": "complete"
        }
      ]
    }
  ]
}
