[Unit]
Description=Deadfall hub: lists and creates online rooms
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/deadfall
# The hub answers on UDP 4100 and starts one deadfall-server per room: Public on 4101, player rooms on 4102-4107.
# It kills every room it started when it stops (and the rooms also quit on their own if the hub dies).
ExecStart=%h/deadfall/deadfall-hub --listen 0.0.0.0:4100 --base-port 4100 --server-bin %h/deadfall/deadfall-server --public-name Public --max-rooms 6 --report-dir %h/.local/share/deadfall/reports
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
# Sandbox. These need unprivileged user namespaces for the user manager; if `systemctl --user status` shows
# status=226/NAMESPACE, comment out ProtectSystem, ReadWritePaths and PrivateTmp (see deploy/README.md).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/deadfall
PrivateTmp=true
UMask=0077
MemoryMax=1536M
TasksMax=128

[Install]
WantedBy=default.target
