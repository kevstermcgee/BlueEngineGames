[Unit]
Description=Point the Deadfall DuckDNS name at this machine's current public IP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# DOMAIN (the name without .duckdns.org) and TOKEN live in this file, which is never in the repository (chmod 600).
EnvironmentFile=%h/.config/deadfall/duckdns.env
# The script passes the token to curl on stdin, so it never appears in a command line, `ps` or the journal.
ExecStart=%h/deadfall/deadfall-ddns.sh
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
