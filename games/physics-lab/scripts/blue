#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

cmd="${1:-help}"
case "$cmd" in
  check)
    shift
    python3 scripts/check.py "$@"
    ;;
  build-all)
    cargo build --release
    ;;
  dev)
    shift
    python3 scripts/dev.py "$@"
    ;;
  play)
    python3 scripts/dev.py --release
    ;;
  package)
    shift
    python3 scripts/ship.py package "$@"
    ;;
  shortcut)
    shift
    python3 scripts/ship.py shortcut "$@"
    ;;
  ship)
    shift
    python3 scripts/ship.py ship "$@"
    ;;
  *)
    echo "Usage: scripts/blue {check|build-all|dev|play|package|shortcut|ship}"
    ;;
esac
